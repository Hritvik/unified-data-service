# Unified Data Service local defaults.
# Copy to .env.local for machine-specific overrides. Do not commit secrets.

UDS_APP_NAME=unified-data-service
UDS_VERSION=1.0.0
UDS_DEBUG=true
UDS_HOST=0.0.0.0
UDS_PORT=8080

UDS_DATABASE__MONGODB_URI=mongodb://admin:password@mongodb:27017
UDS_DATABASE__MONGODB_DATABASE=unified_data_service

UDS_CACHE__REDIS_HOST=redis
UDS_CACHE__REDIS_PORT=6379
UDS_CACHE__REDIS_DB=0
UDS_CACHE__REDIS_PASSWORD=

UDS_EVENT_SERVICE__ENABLED=false
UDS_METRICS__ENABLED=true
UDS_METRICS__PORT=9090
UDS_CONFIG_DIRECTORY=/app/config/services

# Registry/image settings for portable builds.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-org-or-username
IMAGE_NAME=unified-data-service
IMAGE_TAG=dev
UDS_IMAGE=ghcr.io/your-github-org-or-username/unified-data-service:dev
